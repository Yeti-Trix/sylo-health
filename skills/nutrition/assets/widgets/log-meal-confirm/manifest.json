{
  "id": "log-meal-confirm",
  "description": "Review proposed meal items and macros before saving to the local meal log.",
  "entry": "widget.html",
  "fallback": "fallback.md",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["description", "items"],
    "properties": {
      "description": { "type": "string" },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["name", "calories", "protein_g", "carbs_g", "fat_g"],
          "properties": {
            "name": { "type": "string" },
            "serving": { "type": "string" },
            "calories": { "type": "number" },
            "protein_g": { "type": "number" },
            "carbs_g": { "type": "number" },
            "fat_g": { "type": "number" }
          }
        }
      },
      "source": {
        "type": "string",
        "enum": ["operator_text", "operator_photo", "agent_estimate"]
      },
      "lookup_note": { "type": "string" },
      "warn_guess": { "type": "boolean" },
      "notes": { "type": "string" },
      "calories": { "type": "number" },
      "protein_g": { "type": "number" },
      "carbs_g": { "type": "number" },
      "fat_g": { "type": "number" }
    },
    "additionalProperties": true
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["action"],
    "properties": {
      "action": { "type": "string", "enum": ["confirm", "cancel"] },
      "description": { "type": "string" },
      "items": { "type": "array" },
      "source": { "type": "string" },
      "notes": { "type": "string" },
      "calories": { "type": "number" },
      "protein_g": { "type": "number" },
      "carbs_g": { "type": "number" },
      "fat_g": { "type": "number" }
    },
    "additionalProperties": true
  },
  "required_capabilities": ["sendToAgent"],
  "max_input_bytes": 16384,
  "max_output_bytes": 16384
}
